{
  "name": "local-events",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@local-events/data-workers",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:e2e:setup": "pnpm --filter @local-events/db exec tsx ../../scripts/ensure-e2e-db.ts && DATABASE_URL=${E2E_DATABASE_URL:-postgres://events:events@localhost:15432/events_e2e} pnpm db:migrate",
    "test:e2e": "pnpm db:e2e:setup && playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm db:e2e:setup && playwright test -c tests/e2e/playwright.config.ts --headed",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-git-hooks.mjs",
    "worker:test": "pnpm --filter @local-events/data-workers dev -- --source example-fixture",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @local-events/db db:generate",
    "db:migrate": "pnpm --filter @local-events/db db:migrate",
    "api-client:generate": "tsx apps/api/scripts/export-openapi.ts && pnpm --filter @local-events/api-client generate",
    "development:update": "pnpm --filter @local-events/mobile development:update",
    "staging:update": "pnpm --filter @local-events/mobile staging:update",
    "release:update": "pnpm --filter @local-events/mobile release:update"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
