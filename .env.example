# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://events:events@localhost:5432/events
# Playwright (`pnpm test:e2e`) uses a separate disposable DB + ports 3090/3190 so it
# never writes into the `events` database that `pnpm dev` uses.
# E2E_DATABASE_URL=postgres://events:events@localhost:5432/events_e2e
VALKEY_URL=redis://localhost:6379
API_PORT=3000
ADMIN_API_PORT=3001
# Comma-separated browser origins for credentialed CORS (web + Expo).
# Defaults cover Next.js (:3100) and Expo web (:8081). A lone * reflects the request Origin.
# CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:8081,http://127.0.0.1:8081
# Until SES is wired, verification tokens are returned in the register JSON locally.
# On AWS non-prod, INCLUDE_VERIFICATION_TOKEN=true is set by CDK.
# INCLUDE_VERIFICATION_TOKEN=true
# Used to sign session tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
# AWS region (also used by local ElasticMQ clients)
AWS_REGION=eu-north-1
# Local SQS stand-in (`pnpm db:up` starts ElasticMQ). Dummy creds are fine.
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Domain-event queue. Local ElasticMQ URL below; in AWS use CDK DomainEventsQueueUrl.
# When unset, APIs keep events in-process and the worker idles without crash-looping.
DOMAIN_EVENTS_QUEUE_URL=http://localhost:9324/000000000000/domain-events
# Stats: worker always PUTs via the API (never writes the stats table itself).
# Same token must be set on the API. Base URL includes the version prefix.
API_URL=http://localhost:3000/v1
STATS_WORKER_TOKEN=dev-stats-worker-token
# Optional alias for the stats PUT base (defaults to API_URL):
# STATS_API_URL=http://localhost:3000/v1
# Sentry (optional locally — leave unset to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
