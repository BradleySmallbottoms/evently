# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://events:events@localhost:5432/events
VALKEY_URL=redis://localhost:6379
API_PORT=3000
ADMIN_API_PORT=3001
# Comma-separated browser origins allowed to call the API (credentials CORS).
# Defaults cover Next.js web (:3100) and Expo web (:8081).
# CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:8081,http://127.0.0.1:8081
# Used to sign session tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
# AWS (only needed when running against real AWS resources)
AWS_REGION=eu-north-1
# Sentry (optional locally — leave unset to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
