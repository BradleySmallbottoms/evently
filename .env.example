# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://events:events@localhost:15432/events
# Playwright (`pnpm test:e2e`) uses a separate disposable DB + ports 13090/13190 so it
# never writes into the `events` database that `pnpm dev` uses.
# E2E_DATABASE_URL=postgres://events:events@localhost:15432/events_e2e
VALKEY_URL=redis://localhost:16379
API_PORT=13000
ADMIN_API_PORT=13001
# Admin console (apps/admin on :13200). Creates the first admin_users row when the table is empty.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=change-me-long-password
# Email codes are returned by POST /admin/login/otp when NODE_ENV is not production.
# ADMIN_INCLUDE_LOGIN_OTP=false hides them. Do not set true on a public host.
# Optional stable pepper for those code hashes. Unset uses a new pepper each process start.
# ADMIN_OTP_PEPPER=
# NEXT_PUBLIC_ADMIN_API_URL=http://localhost:13001/v1
# ADMIN_CORS_ORIGINS=http://localhost:13200,http://127.0.0.1:13200
# When opening admin via an /etc/hosts alias (not localhost), set BOTH:
#   ALLOWED_DEV_ORIGINS=<hostname>   # apps/admin/.env.local — else /_next is 403, login does nothing
#   ADMIN_CORS_ORIGINS=...,http://<hostname>:13200
# and keep NEXT_PUBLIC_ADMIN_API_URL on the same site as the UI (SameSite=Lax cookies).
# Comma-separated browser origins for credentialed CORS (web + Expo).
# Defaults cover Next.js (:13100) and Expo web (:18081). A lone * reflects the request Origin.
# CORS_ORIGINS=http://localhost:13100,http://127.0.0.1:13100,http://localhost:18081,http://127.0.0.1:18081
# Until SES is wired, verification tokens are returned in the register JSON locally.
# On AWS non-prod, INCLUDE_VERIFICATION_TOKEN=true is set by CDK.
# INCLUDE_VERIFICATION_TOKEN=true
# Used to sign session tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me
# AWS region (also used by local ElasticMQ clients)
AWS_REGION=eu-north-1
# Local SQS stand-in (`pnpm db:up` starts ElasticMQ). Dummy creds are fine.
AWS_ENDPOINT_URL_SQS=http://localhost:19324
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Domain-event queue. Local ElasticMQ URL below; in AWS use CDK DomainEventsQueueUrl.
# When unset, APIs keep events in-process and the worker idles without crash-looping.
DOMAIN_EVENTS_QUEUE_URL=http://localhost:19324/000000000000/domain-events
# Stats: worker always PUTs via the API (never writes the stats table itself).
# Same token must be set on the API. Base URL includes the version prefix.
API_URL=http://localhost:13000/v1
STATS_WORKER_TOKEN=dev-stats-worker-token
# Optional alias for the stats PUT base (defaults to API_URL):
# STATS_API_URL=http://localhost:13000/v1
# Worker only. When set, due pushes still write push_message_deliveries (status dry_run)
# and inbox rows, but the worker does not POST to Expo.
# PUSH_DRY_RUN=1
# Visit Söderhamn data worker (Citybreak CBIS). Not stored in data_sources.config.
# VISIT_SODERHAMN_API_KEY=
# Tickster Event API. Not stored in data_sources.config.
# TICKSTER_API_KEY=
# Data workers ask a local Ollama model for tags. Set this to skip those lookups.
# OLLAMA_DISABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# Hosted scan chat. Leave CHAT_PROVIDER unset to keep Ollama. Set one of these:
# CHAT_PROVIDER=chatgpt
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# CHAT_PROVIDER=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Local Garage (S3-compatible), started by `pnpm db:up`. These keys are dev-only.
# S3 API is path-style on :13900. Browsers load heroes from the website endpoint.
S3_ENDPOINT=http://127.0.0.1:13900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK11111111111111111111111111111111
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PUBLIC_ASSETS_BUCKET=local-events-assets
ASSETS_PUBLIC_BASE_URL=http://local-events-assets.localhost:13902
# RAW_INGESTION_BUCKET is optional locally. Set it to a Garage bucket if you want raw payloads.
# Sentry (optional locally — leave unset to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
# EAS iOS/Android builds upload native source maps via sentry-cli. Until you set
# SENTRY_AUTH_TOKEN (sensitive) + SENTRY_ORG + SENTRY_PROJECT on EAS, builds use
# SENTRY_DISABLE_AUTO_UPLOAD=true (and SENTRY_CLI_EXECUTABLE=true to skip a
# pnpm resolution crash before that check) in apps/mobile/eas.json. Mobile also
# depends on @sentry/cli so require.resolve works in the monorepo. To enable
# uploads: remove those env keys from eas.json and configure the plugin
# organization/project (or SENTRY_ORG / SENTRY_PROJECT) on the Expo project.
# Mobile share links + Universal / App Links (apps/mobile + apps/web association routes).
# EXPO_PUBLIC_WEB_URL=https://events.example.com
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=se.candybanana.lcly
# ANDROID_PACKAGE=se.candybanana.lcly
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:…
