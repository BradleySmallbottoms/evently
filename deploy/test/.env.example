# Test server. Copy to deploy/test/.env and fill the blanks.
# Passwords are hex so they stay safe inside DATABASE_URL.
#
#   openssl rand -hex 24          # POSTGRES_PASSWORD, STATS_WORKER_TOKEN, SESSION_SECRET
#   printf 'GK%s' "$(openssl rand -hex 15)"   # S3_ACCESS_KEY_ID (GK + 30 hex)
#   openssl rand -hex 32          # S3_SECRET_ACCESS_KEY, GARAGE_RPC_SECRET
#   openssl rand -hex 24          # GARAGE_ADMIN_TOKEN, GARAGE_METRICS_TOKEN
#   openssl rand -hex 18          # ADMIN_BOOTSTRAP_PASSWORD

# Apex you control. One wildcard A record (*.this name, and the name itself) points at the instance.
DOMAIN=
# Let's Encrypt account. Port 80 must be open.
ACME_EMAIL=

POSTGRES_PASSWORD=
STATS_WORKER_TOKEN=
SESSION_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# First admin row, created when admin_users is empty. Enroll TOTP on the first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Tips use Anthropic. Leave unset and a tip saves nothing useful.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Import schedule (`docker compose --profile ingest up -d`). A small instance cannot run Ollama.
# OLLAMA_DISABLED=1
# CHAT_PROVIDER=claude
# SOURCE_SLUG=visit-soderhamn
# INGEST_INTERVAL_SECONDS=21600
# VISIT_SODERHAMN_API_KEY=
# BRAVE_API_KEY=

# Worker writes deliveries but does not call Expo until this is 0.
# PUSH_DRY_RUN=1

# Universal Links / App Links on the web host. Optional until a store build exists.
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=se.candybanana.lcly
# ANDROID_PACKAGE=se.candybanana.lcly
# ANDROID_SHA256_CERT_FINGERPRINTS=
