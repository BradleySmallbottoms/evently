{
	email {$ACME_EMAIL}
}

{$WEB_HOST} {
	encode zstd gzip
	reverse_proxy web:13100
}

{$API_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy api:13000
}

{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin:13200
}

{$ADMIN_API_HOST} {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy admin-api:13001
}

# The image service reads Garage and returns a resized WebP.
# assets.<domain> is the public name. assets-origin.<domain> is the CloudFront origin.
{$ASSETS_HOST}, {$ASSETS_ORIGIN_HOST} {
	reverse_proxy images:13910
}
