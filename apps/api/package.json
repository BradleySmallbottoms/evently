{
  "name": "@local-events/api",
  "version": "0.0.0",
  "apiVersion": 1,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --external:argon2 --banner:js=\"import { createRequire as createNodeRequire } from 'node:module'; const require = createNodeRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/apps/api --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@local-events/auth": "workspace:*",
    "@local-events/contracts": "workspace:*",
    "@local-events/db": "workspace:*",
    "@local-events/domain": "workspace:*",
    "@sentry/node": "^11.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@local-events/config": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
