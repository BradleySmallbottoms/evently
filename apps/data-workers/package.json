{
  "name": "@local-events/data-workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/apps/data-workers --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@local-events/contracts": "workspace:*",
    "@local-events/db": "workspace:*",
    "@local-events/domain": "workspace:*",
    "@local-events/ingest": "workspace:*",
    "@sentry/node": "^11.4.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@local-events/config": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
