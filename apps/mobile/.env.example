# iOS Simulator: 127.0.0.1 (localhost resolves to IPv6 and the request fails).
# Physical phone: the Mac's LAN address, e.g. http://192.168.1.10:3000/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/v1

# Public web origin for shareable event links (opens the app via Universal / App Links
# when EXPO_PUBLIC_WEB_URL is https and association files are deployed on that host).
# Local default matches `pnpm --filter @local-events/web dev` (:3100).
EXPO_PUBLIC_WEB_URL=http://localhost:3100
